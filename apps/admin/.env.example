# Kopiraj u .env.local i popuni pravim vrednostima iz Supabase projekta.
# .env.local se NIKAD ne commit-uje (proveri .gitignore).
#
# Dev i prod su ODVOJENI Supabase projekti — ne deli isti projekat između
# lokalnog razvoja i produkcije. Vercel deploy koristi svoje env varijable
# (Project Settings -> Environment Variables), ne ovaj fajl.

# Prisma — connection string ka Postgres bazi (Supabase: Connect -> ORM -> Prisma)
# DATABASE_URL: transaction-mode pooler (runtime upiti aplikacije)
# DIRECT_URL: session-mode pooler (koristi je Prisma CLI za migracije)
DATABASE_URL=
DIRECT_URL=

# Supabase — Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role ključ — SAMO server-side (API rute, server actions). Nikad u client kod.
SUPABASE_SERVICE_ROLE_KEY=
