# Kopiraj u .env.local i popuni pravim vrednostima iz Supabase projekta
# (ISTI projekat kao apps/admin — sajt čita iste ponude koje admin puni).
# .env.local se NIKAD ne commit-uje (proveri .gitignore).
#
# Dev i prod su ODVOJENI Supabase projekti — ne deli isti projekat između
# lokalnog razvoja i produkcije. Vercel deploy koristi svoje env varijable
# (Project Settings -> Environment Variables), ne ovaj fajl.

# Supabase — Project Settings -> Data API
# Koristi se SAMO server-side (Server Components) sa anon ključem — browser
# korisnika nikad ne dodiruje Supabase direktno, RLS (offers_select_public)
# dozvoljava anon roli da čita samo objavljene ponude.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role ključ — koristi ga /go/[offerId] (klik-tracking, Faza 4):
# upisuje u clicks i čita kontakt_url, a anoniman posetilac nema sesiju ni
# pristup toj koloni preko anon ključa. SAMO server-side, nikad u client kod.
SUPABASE_SERVICE_ROLE_KEY=
